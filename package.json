{
  "name": "muraveivision-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "backend": "set COLMAP_ROOT=sidecars\\colmap&& set MURAVEI_SESSION_TRACE=1&& muravei_env\\Scripts\\python.exe -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000",
    "backend:watch": "set COLMAP_ROOT=sidecars\\colmap&& set MURAVEI_SESSION_TRACE=1&& muravei_env\\Scripts\\python.exe -m uvicorn main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "backend:install": "muravei_env\\Scripts\\pip.exe install --no-cache-dir -r backend\\requirements.txt",
    "desktop": "muravei_env\\Scripts\\python.exe backend\\desktop_launcher.py",
    "smoke:phase3": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_phase3.py",
    "smoke:phase4": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_phase4.py",
    "smoke:geo": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_geo_telemetry.py",
    "smoke:flight3d": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_flight3d.py",
    "smoke:recon": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_recon_layout.py",
    "smoke:rec60": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_rec_60s.py",
    "smoke:fullkit": "muravei_env\\Scripts\\python.exe backend\\scripts\\smoke_fullkit_layout.py",
    "test:yolo-scrub-gate": "playwright test yolo-scrub-gate.test.ts",
    "portable": "powershell -ExecutionPolicy Bypass -File scripts/build_portable.ps1 -FetchEmbeddablePython",
    "portable:mini": "powershell -ExecutionPolicy Bypass -File scripts/build_portable.ps1 -FetchEmbeddablePython -NoDetectWeights",
    "portable:full": "powershell -ExecutionPolicy Bypass -File scripts/build_portable.ps1 -FetchEmbeddablePython -FullKit",
    "test:yolo-scrub": "playwright test yolo-scrub-gate.test.ts",
    "test:field": "playwright test yolo-scrub-gate.test.ts field-regression.test.ts recon-raycast.test.ts test_ui_toggles.test.ts test_hotkeys.test.ts test_event_timeline.test.ts",
    "test": "npm run test:all",
    "test:all": "muravei_env\\Scripts\\python.exe scripts\\test_orchestrator.py"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "autoprefixer": "^10.4.16",
    "lucide-react": "^1.31.0",
    "postcss": "^8.4.32",
    "react": "^19.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "react-mosaic-component": "^7.0.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.0",
    "three": "^0.170.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}

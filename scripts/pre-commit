#!/usr/bin/env bash
# Pre-commit gate for MuraveiVision PRO.
# Runs the FAST backend checks only (unit tests + compileall) so commits stay
# responsive. Full smoke + E2E are handled by `npm run test:all` (orchestrator)
# and CI — too slow for a commit hook.
#
# Install with: bash scripts/install-hooks.sh
# Skip once with: git commit --no-verify

set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PY="$ROOT/muravei_env/Scripts/python.exe"
if [ ! -f "$PY" ]; then
  PY="python"
fi

echo "[pre-commit] backend unit tests..."
( cd backend && "$PY" -m unittest discover -s tests )
echo "[pre-commit] backend compileall..."
"$PY" -m compileall backend -q

echo "[pre-commit] all checks passed."
